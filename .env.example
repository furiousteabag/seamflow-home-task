# Supabase Postgres, transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
ANTHROPIC_API_KEY=sk-ant-...
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only, used for private Storage
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_POWERSYNC_URL=https://xxxx.powersync.journeyapps.com
# Only for deploying powersync/ config with the CLI
POWERSYNC_DATABASE_PASSWORD=
